generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  cart      CartItem[]
  wishlist  WishlistItem[]
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  variantId Int?    // Optional: link to a specific variant
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  image       String?
  isActive    Boolean   @default(true)
  showOnHome  Boolean   @default(false)
  subHeading  String?
  parentId    Int?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryToCategory")

  products        Product[] @relation("ProductCategory")
  relatedProducts Product[] @relation("ProductRelatedCategory")
  youMightAlso    Product[] @relation("ProductYouMightAlso")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              Int     @id @default(autoincrement())
  name            String
  slug            String  @unique
  sku             String? @unique
  modelNo         String? // "Product" field in spec
  ean             String?
  description     String? @db.LongText
  mainImage       String?
  variantImage    String?
  material        String?
  packaging       String?
  origin          String? // Country of Origin
  shippingDetails String? @db.Text
  isActive        Boolean @default(true)
  showOnHome      Boolean @default(false)

  categoryId Int
  category   Category @relation("ProductCategory", fields: [categoryId], references: [id])

  relatedCategoryId Int?
  relatedCategory   Category? @relation("ProductRelatedCategory", fields: [relatedCategoryId], references: [id])

  youMightAlsoCategoryId Int?
  youMightAlsoCategory   Category? @relation("ProductYouMightAlso", fields: [youMightAlsoCategoryId], references: [id])

  gallery   ProductImage[]
  variants  ProductVariant[]
  documents ProductDocument[]

  isOurCollection Boolean @default(false)
  isCraftedSelection Boolean @default(false)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cart      CartItem[]
  wishlist  WishlistItem[]
  OrderItem OrderItem[]
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  data      Json // Flexible fields: {"Weight (gm)": "425", "Size (cm)": "12", "Liter": "1"}
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductDocument {
  id        Int     @id @default(autoincrement())
  name      String
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model VariantGroup {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  fields    Json // Array of field names: ["Weight (gm)", "Size (cm)", "Material"]
  items     VariantGroupItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model VariantGroupItem {
  id      Int          @id @default(autoincrement())
  data    Json // Values matching fields: {"Weight (gm)": "450", "Size (cm)": "15"}
  groupId Int
  group   VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  address   String?  @db.Text
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryPartner {
  id          Int      @id @default(autoincrement())
  name        String
  logo        String?
  contactInfo String?
  isActive    Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                Int             @id @default(autoincrement())
  userId            Int?
  user              User?           @relation(fields: [userId], references: [id])
  deliveryPartnerId Int?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  customerName      String
  customerPhone     String
  customerAddress   String          @db.Text
  status            String          @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  items             OrderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerId Int?
  customer   Customer?    @relation(fields: [customerId], references: [id])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}
